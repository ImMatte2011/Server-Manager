SERVER_MANAGER_ENV=production
SERVER_MANAGER_HOST=127.0.0.1
SERVER_MANAGER_PORT=8080
SERVER_MANAGER_API_TOKEN=replace-with-a-long-random-token
SERVER_MANAGER_CONFIG=/etc/server-manager/services.toml
SERVER_MANAGER_DB=/var/lib/server-manager/server-manager.db
SERVER_MANAGER_ACTOR=admin
SERVER_MANAGER_LOG_LEVEL=INFO
SERVER_MANAGER_DISK_PATH=/
# Set to 1 only if sudoers explicitly allows the exact systemctl commands Server Manager needs.
SERVER_MANAGER_SYSTEMCTL_SUDO=0
